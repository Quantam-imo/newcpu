[Unit]
Description=AstroQuant Signal Orchestrator
After=network.target astroquant_tradingbot.service chrome_remote_debug.service

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__WORKSPACE__
ExecStart=__WORKSPACE__/.venv/bin/python3 __WORKSPACE__/start_astroquant.py
Restart=always
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target