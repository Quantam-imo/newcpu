[Unit]
Description=AstroQuant Signal Orchestrator
After=network-online.target astroquant_tradingbot.service chrome_remote_debug.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__WORKSPACE__
EnvironmentFile=-__WORKSPACE__/.env
Environment=PYTHONPATH=__WORKSPACE__
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536
ExecStart=__WORKSPACE__/.venv/bin/python3 __WORKSPACE__/start_astroquant.py
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=astroquant-orchestrator

[Install]
WantedBy=multi-user.target
