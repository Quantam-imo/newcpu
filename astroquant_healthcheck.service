[Unit]
Description=AstroQuant System Health Check
After=astroquant_orchestrator.service astroquant_celery.service astroquant_calibrate.service

[Service]
Type=oneshot
User=__SERVICE_USER__
WorkingDirectory=__WORKSPACE__
ExecStart=/bin/bash __WORKSPACE__/health_check.sh
TimeoutSec=60

[Install]
WantedBy=multi-user.target