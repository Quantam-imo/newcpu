[Unit]
Description=AstroQuant Celery Worker
After=network.target astroquant_tradingbot.service

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__WORKSPACE__
ExecStart=__WORKSPACE__/.venv/bin/celery -A astroquant.backend.tasks.celery_worker worker --loglevel=info
Restart=always
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target