[Unit]
Description=AstroQuant Playwright Selector Calibration
After=chrome_remote_debug.service astroquant_tradingbot.service

[Service]
Type=oneshot
User=__SERVICE_USER__
WorkingDirectory=__WORKSPACE__
ExecStart=__WORKSPACE__/.venv/bin/python3 __WORKSPACE__/astroquant/execution/matchtrader_executor.py --mode calibrate --cdp-url ws://127.0.0.1:9222 --manual-login-timeout 30
TimeoutSec=120

[Install]
WantedBy=multi-user.target