[Unit]
Description=Chrome with Remote Debugging for AstroQuant
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__WORKSPACE__
EnvironmentFile=-__WORKSPACE__/.env
Environment=DISPLAY=:99
ExecStartPre=/bin/bash -c "pgrep -f 'Xvfb :99' || Xvfb :99 -screen 0 1280x900x24 -ac +extension GLX +render -noreset &"
ExecStart=/bin/bash __WORKSPACE__/start_chrome_remote_debug.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
