[Unit]
Description=AstroQuant Live Sync Engine
After=network.target astroquant_tradingbot.service

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__WORKSPACE__
ExecStart=__WORKSPACE__/.venv/bin/python3 __WORKSPACE__/start_live_sync.py
Restart=always
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
