# AstroQuant Environment Variables Example
# Copy this file to .env and fill in your secrets

# Databento API Key (required for live/historical market data)
DATABENTO_API_KEY=

# Active trading symbol universe (comma-separated).
# These symbols auto-connect Databento feeds and broker spot cache on startup.
# Symbols outside this list are rejected at runtime.
# Popular setup: XAUUSD, GC.FUT, NQ, EURUSD, US30
AQ_RUNTIME_SYMBOLS=XAUUSD,NQ,EURUSD,US30,GC.FUT

# Chrome DevTools Protocol (CDP) endpoint (default for local Chrome)
CDP_ENDPOINT=ws://127.0.0.1:9222
EXECUTION_BROWSER_CDP_URL=ws://127.0.0.1:9222
EXECUTION_BROWSER_AUTO_ATTACH=true
EXECUTION_BROWSER_TIMEOUT_MS=30000

# Order Execution
ORDER_EXECUTION_MODE=confirm-token
ORDER_SYMBOL_LOCK=true
ORDER_MICRO_LOT_SIZE=0.01

# Risk Management
DAILY_LOSS_LIMIT_USD=500
MAX_CONCURRENT_POSITIONS=3
DRAWDOWN_MAX_PERCENT=10

# Add any other secrets or environment variables required by your deployment below
# Example:
# BROKER_USERNAME=your_broker_username
# BROKER_PASSWORD=your_broker_password
# MENTOR_ADMIN_PASSWORD=use_a_long_random_secret

# Telegram automation (required for unattended alerts/reports)
TELEGRAM_ALERT_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SIGNAL_SYMBOL=XAUUSD
TELEGRAM_SIGNAL_SYMBOLS=XAUUSD,GC.FUT,NQ.FUT
TELEGRAM_REPORT_INTERVAL_SEC=900
TELEGRAM_REPORT_MODE=full
TELEGRAM_DAILY_SUMMARY_ENABLED=true
TELEGRAM_DAILY_SUMMARY_UTC=09:00
TELEGRAM_DAY_BOUNDARY_REPORTS_ENABLED=true
TELEGRAM_DAY_START_UTC=00:05
TELEGRAM_DAY_END_UTC=23:55
TELEGRAM_DAEMON_HEALTH_INTERVAL_SEC=1800
TELEGRAM_STARTUP_ALERT_COOLDOWN_SEC=900
